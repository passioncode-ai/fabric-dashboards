{
  "protocol": "fabric-service/0.1",
  "id": "example-agent",
  "instance": "default",
  "name": "Example Agent",
  "summary": "Drafts and files reports for its operator.",
  "origin": "http://127.0.0.1:47195",
  "auth": {
    "tokenFile": "~/.config/example-agent/service.token",
    "header": "X-Example-Token",
    "scheme": "none"
  },
  "lifecycle": {
    "manager": "task-scheduler"
  },
  "paths": {
    "data": "~/Library/Application Support/example-agent",
    "logs": [
      "~/Library/Application Support/example-agent/logs/service.log"
    ]
  },
  "commands": {
    "doctor": [
      "~/Code/example-agent/.venv/bin/publisher",
      "doctor",
      "--json"
    ]
  },
  "source": {
    "repository": "https://github.com/example/example-agent"
  },
  "installedAt": "2026-09-28T18:00:00Z",
  "installedBy": "example-agent service install 0.2.0"
}
